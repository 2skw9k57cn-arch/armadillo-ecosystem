# ── Notification settings (set in ~/.hermes/.env — never commit real values) ──
# Slack / Discord / Teams incoming webhook
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Telegram bot token + chat ID
# NOTIFY_TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# NOTIFY_TELEGRAM_CHAT_ID=-1001234567890

# Email recipient (requires sendmail / msmtp configured on the host)
# NOTIFY_EMAIL=you@example.com

# DO NOT commit:
# - ~/.config/acp-cli/signer-keys.json (private keys)
# - ~/.hermes/.env (auth tokens)
# - /tmp/acp-events-*.jsonl (event logs with job details)
# - ~/.hermes/data/*.jsonl (profit engine decision logs)
